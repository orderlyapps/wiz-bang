{
  "name": "wiz-bang",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host",
    "dev:app": "bash scripts/dev-app.sh",
    "dev:app:base": "vp run dev:app base",
    "dev:app:admin": "vp run dev:app admin",
    "dev:app:proclaimer": "vp run dev:app proclaimer",
    "dev:app:subbie": "vp run dev:app subbie",
    "build": "tsc -b && vp build",
    "build:app": "bash scripts/build-app.sh",
    "supabase:update": "brew upgrade supabase",
    "supabase:download:public_schema": "supabase db dump --schema public -f src/apps/shared/database/public_schema.sql",
    "lint": "vp lint .",
    "preview": "vp preview",
    "deploy": "vp build && wrangler pages deploy dist --project-name=orderly --branch=wiz-bang && echo DEPLOYED TO WIZ BANG",
    "deploy:app": "bash scripts/deploy-app.sh",
    "deploy:app:base": "vp run deploy:app base",
    "deploy:app:orderly": "vp run deploy:app admin",
    "deploy:app:proclaimer": "vp run deploy:app proclaimer"
  },
  "dependencies": {
    "@ionic/react": "^8.8.6",
    "@ionic/react-router": "^8.8.6",
    "@maskito/core": "^5.2.2",
    "@maskito/phone": "^5.2.2",
    "@maskito/react": "^5.2.2",
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/supabase-js": "^2.106.0",
    "@tanstack/browser-db-sqlite-persistence": "^0.1.9",
    "@tanstack/query-db-collection": "^1.0.36",
    "@tanstack/react-db": "^0.1.83",
    "@tanstack/react-query": "^5.64.0",
    "@tanstack/react-query-devtools": "^5.64.0",
    "@tanstack/rxdb-db-collection": "^0.1.71",
    "ionicons": "^8.0.13",
    "libphonenumber-js": "^1.11.21",
    "mapbox-gl": "^3.23.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-map-gl": "^8.1.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "workbox-window": "^7.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "supabase": "^2.100.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plus": "catalog:",
    "wrangler": "^4.90.0"
  },
  "packageManager": "pnpm@11.0.8"
}
